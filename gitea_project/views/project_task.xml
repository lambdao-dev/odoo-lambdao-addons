<odoo>
  <record id="project_task_gitea" model="ir.ui.view">
        <field name="name">project.task.gitea</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">project_task_gitea_tree</attribute>
            </xpath>
        </field>
  </record>
  <record model="ir.ui.view" id="view_form_project_task">
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="name">project.task.form.gitea</field>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="before">
            <field name="gitea_repository_id" invisible="1" />
            <field
                    name="gitea_status"
                    attrs="{'invisible': [('gitea_repository_id', '==', False)]}"
                />
            <field
                    name="gitea_issue_number"
                    attrs="{'invisible': [('gitea_repository_id', '==', False)]}"
                />
        </xpath>
    </field>
  </record>
</odoo>
